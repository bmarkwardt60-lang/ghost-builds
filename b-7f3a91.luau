Nav.Hud.Layout(item)
Connect(object.InputBegan,function(input)
if Settings.UI.LockHud or not object.Visible then return end
if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then return end
if Nav.Hud.Active then return end
Nav.Hud.Active={Item=item,Pointer=input,Point=input.Position,Position=object.Position,Moved=false}
end)
end
Connect(UserInputService.InputChanged,function(input)
