function WeaponControl.Scan(tool)
local old=WeaponControl.Known
local known,records,fields={},{},{Recoil=0,Spread=0,Sway=0}
WeaponControl.Limited=false
local function add(object,key,kind,attribute)
if #records>=160 then WeaponControl.Limited=true; return end
local value=attribute and object:GetAttribute(key) or object.Value
if type(value)~="number" and typeof(value)~="Vector3" and typeof(value)~="Vector2" then return end
local record=old[object] and old[object][key]
if not record then record={Object=object,Key=key,Kind=kind,Attribute=attribute,Original=value} end
