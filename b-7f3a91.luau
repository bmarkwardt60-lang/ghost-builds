end
local item,reason=Assist.Candidate(actor,name,radius,teamCheck,false,"Aim")
if item then
local point=item.Part.Position
if point.X~=point.X or point.Y~=point.Y or point.Z~=point.Z or point.Magnitude==math.huge or item.Pixels~=item.Pixels or item.Distance~=item.Distance then
