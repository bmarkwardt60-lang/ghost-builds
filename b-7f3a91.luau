end
function A.Write(record,value)
local current=record.Tool:GetAttribute(record.Key)
if record.HasWritten and current~=record.Written then record.Original=current end
if current==value then return true end
local ok,err=pcall(function() record.Tool:SetAttribute(record.Key,value) end)
if ok then record.Written=value;record.HasWritten=true else A.LastError=tostring(err) end
return ok
end
function A.SyncMuzzle(state)
local handle=state.Handle
if not handle or not handle.Parent then return end
local native
for _,child in ipairs(handle:GetChildren()) do
if child~=state.Marker and child.Name=="SilencerMuzzle" and child:IsA("Attachment") then native=child;break end
end
if not state.Silenced or native then
if state.Marker then state.Marker:Destroy();state.Marker=nil end
return
end
local muzzle=handle:FindFirstChild("Muzzle")
if not muzzle or not muzzle:IsA("Attachment") then return end
if not state.Marker or state.Marker.Parent~=handle then
local marker=Instance.new("Attachment");marker.Name="SilencerMuzzle"
Ghost.Mark(marker,"LocalSuppressor",true);marker.CFrame=muzzle.CFrame;marker.Parent=handle;state.Marker=marker
elseif state.Marker.CFrame~=muzzle.CFrame then state.Marker.CFrame=muzzle.CFrame end
end
