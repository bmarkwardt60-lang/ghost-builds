Ghost.Surfaces={Members=setmetatable({},{__mode="k"})}
function Ghost.Surfaces.Register(object,props,class)
if props.NoMotion or not object:IsA("GuiObject") or object.BackgroundTransparency>=1 then return end
local node=object;local inside=false
while node do
if node.Name=="GhostAtmosphere" or node.Name=="ESPLayer" or node.Name=="ControlIcon" then return end
if node.Name=="Main" or node.Name=="LoadingCard" then inside=true end
node=node.Parent
end
if not inside then return end
local minimum
if class=="TextButton" or class=="ImageButton" or class=="TextBox" then minimum=.12
elseif class=="Frame" or class=="ScrollingFrame" or class=="CanvasGroup" then
local color=object.BackgroundColor3:ToHex()
for _,role in ipairs({"Background","Sidebar","Element","ElementHi"}) do
if color==Theme[role]:ToHex() then minimum=object.Name=="Main" and .06 or (role=="Sidebar" and .10 or .16);break end
end
end
if minimum then Ghost.Surfaces.Members[object]=minimum;object.BackgroundTransparency=math.max(object.BackgroundTransparency,minimum) end
end
function Ghost.Surfaces.Refresh()
for object,minimum in pairs(Ghost.Surfaces.Members) do
if object.Parent then object.BackgroundTransparency=math.max(object.BackgroundTransparency,minimum) end
end
end
