function Assist.ProjectileInfo(tool)
local cached=Assist.ProjectileCache
if cached and cached.Tool==tool and os.clock()-cached.At<0.25 then return cached.Speed,cached.Gravity,cached.Hitscan end
local function read(names)
for _,name in ipairs(names) do
local value=tool:GetAttribute(name)
if type(value)=="number" and value==value and math.abs(value)<1000000 then return value end
local field=tool:FindFirstChild(name)
if field and (field:IsA("NumberValue") or field:IsA("IntValue")) and field.Value==field.Value and math.abs(field.Value)<1000000 then return field.Value end
end
for _,folder in ipairs({"Ballistics","Configuration","Config","Stats"}) do
local group=tool:FindFirstChild(folder)
if group then
for _,name in ipairs(names) do
local value=group:GetAttribute(name)
local field=group:FindFirstChild(name)
if type(value)~="number" and field and (field:IsA("NumberValue") or field:IsA("IntValue")) then value=field.Value end
if type(value)=="number" and value==value and math.abs(value)<1000000 then return value end
end
end
end
return nil
end
if not tool then return nil,0,false end
if tool:GetAttribute("Hitscan")==true or tool:GetAttribute("IsHitscan")==true then
Assist.ProjectileCache={Tool=tool,At=os.clock(),Gravity=0,Hitscan=true}
