if type(state.Catalog.MagSize)=="function" then
local ok,value=pcall(state.Catalog.MagSize,state.Weapon,state.Mods,record.Original)
if ok and type(value)=="number" and value==value and value>0 and value<=10000 and value%1==0 then
wanted=value;state.CapacityMapped=true
