if not ConfigLoaded or Ghost.Reduced() or not Main.Visible or previous==name or not old then return end
local axis=motion.Owner(previous)==motion.Owner(name) and "X" or "Y"
local direction=motion.Rank(name)>=motion.Rank(previous) and 1 or -1
local span=axis=="X" and 42 or 32
local function offset(amount) return axis=="X" and UDim2.fromOffset(amount,0) or UDim2.fromOffset(0,amount) end
local outgoing=old.Page
local exit,enter=motion.Surfaces[1],motion.Surfaces[2]
motion.Active=true; motion.From=previous; motion.To=name; motion.Direction=direction; motion.Axis=axis
motion.Shield.Visible=true
outgoing.Parent=exit; outgoing.Visible=true; outgoing.Position=positions[previous] or UDim2.new()
incoming.Parent=enter; incoming.Visible=true; incoming.Position=positions[name] or offset(direction*span)
exit.GroupTransparency=transparency[previous] or 0; enter.GroupTransparency=transparency[name] or 1
exit.Visible=true; enter.Visible=true
local epoch=motion.Epoch
motion.Tweens={
Tween(outgoing,0.2,{Position=offset(-direction*span*0.55)},Enum.EasingStyle.Quad),
Tween(exit,0.12,{GroupTransparency=1},Enum.EasingStyle.Quad),
Tween(incoming,0.42,{Position=UDim2.new()},Enum.EasingStyle.Quart),
}
task.delay(0.09,function()
if not Alive or epoch~=motion.Epoch or Nav.Current~=name then return end
table.insert(motion.Tweens,Tween(enter,0.3,{GroupTransparency=0},Enum.EasingStyle.Quart))
end)
task.delay(0.43,function()
if not Alive or epoch~=motion.Epoch or Nav.Current~=name then return end
motion.Settle()
end)
end
local function SelectTab(name)
if not Tabs[name] then return end
if Nav.CloseDropdown then Nav.CloseDropdown(true) end
if Nav.ServerPlayers and Nav.Current~=name then Nav.ServerPlayers.CloseContext() end
local previous=Nav.Current
Nav.Current = name
local dock=name=="Visuals" or name=="Chams"
if Ghost.ESPDockActive~=dock then
Ghost.ESPDockActive=dock
if Nav.Responsive then Nav.Responsive() end
end
Nav.TooltipEpoch = (Nav.TooltipEpoch or 0)+1
if Nav.Tooltip then Nav.Tooltip.Visible = false end
if Nav.RefreshRoutes then Nav.RefreshRoutes(name) end
for n, t in pairs(Tabs) do
local active = (n == name) or (Nav.RouteOwner and Nav.RouteOwner[name]==n)
if t.Marker then t.Marker.Visible=active end
if t.Caption then t.Caption.TextColor3=active and Theme.Text or Theme.SubText end
Icons.Tint(t.Icon,active and Theme.Accent or Theme.SubText)
Tween(t.Button, 0.2, {
BackgroundColor3 = active and Theme.ElementHi or Theme.Sidebar,
TextColor3 = active and Theme.Text or Theme.SubText,
})
end
Nav.PageMotion.Start(previous,name)
if Nav.RefreshProfileDock then Nav.RefreshProfileDock() end
end
