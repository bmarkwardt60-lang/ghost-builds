if not state then return end
if state.Marker then state.Marker:Destroy();state.Marker=nil end
for _,record in ipairs(state.Records) do
pcall(function()
if record.HasWritten and record.Tool:GetAttribute(record.Key)==record.Written then record.Tool:SetAttribute(record.Key,record.Original) end
end)
end
if state.Audio and state.Handle and state.Tool.Parent==LocalPlayer.Character then
local value=state.Tool:GetAttribute("Silenced")
