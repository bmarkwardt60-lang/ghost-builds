end
local function FindTarget(fov: number,partName: string,teamCheck: boolean,wallCheck: boolean,channel: string?): (BasePart?,any)
channel=channel or "Aim"
if channel=="Aim" then return Assist.FindAimTarget(fov,partName,teamCheck,wallCheck) end
local previous=Assist.Locks[channel]
if Settings.Targeting.LockTarget and previous then
local candidate=Assist.Candidate(previous,partName,fov+Settings.Targeting.LockMargin,teamCheck,wallCheck,channel)
if candidate then Assist.Reasons=Assist.Reasons or {}; Assist.Reasons[channel]="Locked"; return candidate.Part,candidate.Player end
end
Assist.Locks[channel]=nil
local best,score=nil,math.huge
local rejected={}
for _,player in ipairs(Ghost.Actors.Roster()) do
local candidate,reason=Assist.Candidate(player,partName,fov,teamCheck,wallCheck,channel)
if candidate then
local priority=Settings.Targeting.Priority
local rank=priority=="Distance" and candidate.Distance or (priority=="Health" and candidate.Health or candidate.Pixels)
rank+=candidate.Pixels*0.000001
if rank<score then best=candidate; score=rank end
elseif reason~="self" then rejected[reason]=(rejected[reason] or 0)+1 end
end
Assist.Reasons=Assist.Reasons or {}
if best then
Assist.Locks[channel]=best.Player; Assist.Reasons[channel]="Acquired"
