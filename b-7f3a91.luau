local N={Parts={},Connections={},Character=nil}
Ghost.Noclip=N
function N.Required()
local farm=Ghost.BlockSpin.Farm
return Settings.Player.Noclip or (farm.Enabled and farm.FlightActive and Settings.BlockSpinFarm.Noclip)
end
function N.Drop(part)
local record=N.Parts[part]
if not record then return end
N.Parts[part]=nil
if record.Connection then record.Connection:Disconnect() end
pcall(function() if part.CanCollide==false then part.CanCollide=record.Original end end)
end
function N.Track(part)
if not part:IsA("BasePart") or N.Parts[part] or not N.Character or not part:IsDescendantOf(N.Character) then return end
local record={Original=part.CanCollide,Writing=false}; N.Parts[part]=record
record.Connection=part:GetPropertyChangedSignal("CanCollide"):Connect(function()
if record.Writing or not Alive or not N.Required() or N.Parts[part]~=record or not part:IsDescendantOf(N.Character) then return end
if part.CanCollide then record.Writing=true; part.CanCollide=false; record.Writing=false end
end)
record.Writing=true; part.CanCollide=false; record.Writing=false
end
function N.Stop()
for _,connection in ipairs(N.Connections) do connection:Disconnect() end
table.clear(N.Connections)
for part in pairs(N.Parts) do N.Drop(part) end
N.Character=nil
end
function N.Step()
local character=LocalPlayer.Character
if not Alive or not N.Required() or not character or not character.Parent then N.Stop(); return end
if N.Character~=character then
N.Stop(); N.Character=character
table.insert(N.Connections,character.DescendantAdded:Connect(N.Track))
table.insert(N.Connections,character.DescendantRemoving:Connect(function(part) if N.Parts[part] then N.Drop(part) end end))
for _,part in ipairs(character:GetDescendants()) do N.Track(part) end
end
for part,record in pairs(N.Parts) do
if not part:IsDescendantOf(character) then N.Drop(part)
elseif part.CanCollide then record.Writing=true; part.CanCollide=false; record.Writing=false end
end
end
Connect(RunService.PreSimulation or RunService.Stepped or RunService.Heartbeat,N.Step)
Connect(LocalPlayer.CharacterAdded,function() N.Stop(); N.Step() end)
Connect(LocalPlayer:GetPropertyChangedSignal("Character"),N.Step)
end
