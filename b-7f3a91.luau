local a,b=math.huge,-math.huge
for _,bone in ipairs(part:GetDescendants()) do if bone:IsA("Bone") then
local x=frame:PointToObjectSpace(bone.TransformedWorldCFrame.Position).X
a=math.min(a,x);b=math.max(b,x)
end end
if b>a then local pad=part.Size.Y/3.987143*.18;left=a-pad;right=b+pad end
end
for _,x in ipairs({-1,1}) do for _,y in ipairs({-1,1}) do for _,z in ipairs({-1,1}) do
local p=frame*Vector3.new(x<0 and left or right,half.Y*y,half.Z*z)
low=low and Vector3.new(math.min(low.X,p.X),math.min(low.Y,p.Y),math.min(low.Z,p.Z)) or p
high=high and Vector3.new(math.max(high.X,p.X),math.max(high.Y,p.Y),math.max(high.Z,p.Z)) or p
end end end
end
end
if not low then local cf,size=model:GetBoundingBox();return cf.Position,size end
return (low+high)*.5,high-low
end
