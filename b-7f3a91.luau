local function SpawnTracer(origin, hitPos)
local T = Settings.Tracer
local c1 = ColorOf(T, "Color1", "Rainbow", 0)
local c2 = ColorOf(T, "Color2", "Rainbow", 0.3)
local function point(pos)
local part = Instance.new("Part")
part.Anchored = true
part.CanCollide = false
part.CanQuery = false
part.CanTouch = false
part.Transparency = 1
part.Size = Vector3.new(0.1, 0.1, 0.1)
part.CFrame = CFrame.new(pos)
part.Parent = TracerFolder
local att = Instance.new("Attachment")
att.Parent = part
return part, att
end
local p0, a0 = point(origin)
local p1, a1 = point(hitPos)
local function beam(width, colors, transparency)
local b = Instance.new("Beam")
b.Attachment0 = a0
b.Attachment1 = a1
b.Color = colors
b.Width0 = width
b.Width1 = width
b.LightEmission = 1
b.LightInfluence = 0
b.FaceCamera = true
b.Segments = 1
b.Transparency = NumberSequence.new(transparency)
b.Parent = p0
return b
end
local t = {
Born = os.clock(),
Life = math.clamp(tonumber(T.Lifetime) or 1,0.05,3),
P0 = p0,
P1 = p1,
Halo = beam(T.Thickness * T.Glow, ColorSequence.new(c1, c2), 0.75),
Mid = beam(T.Thickness, ColorSequence.new(c1, c2), 0),
}
if T.Core then
t.Core = beam(T.Thickness * 0.35, ColorSequence.new(WHITE), 0.1)
end
if T.Impact then
local ball = Instance.new("Part")
ball.Shape = Enum.PartType.Ball
ball.Material = Enum.Material.Neon
ball.Color = c2
ball.Size = Vector3.new(0.4, 0.4, 0.4)
ball.Anchored = true
ball.CanCollide = false
ball.CanQuery = false
ball.CanTouch = false
ball.CFrame = CFrame.new(hitPos)
ball.Parent = TracerFolder
t.Impact = ball
if T.ImpactLight then
local light = Instance.new("PointLight")
light.Color = c2
light.Brightness = 3
light.Range = 10
light.Parent = ball
t.Light = light
end
end
table.insert(ActiveTracers, t)
if #ActiveTracers > 80 then
local old = table.remove(ActiveTracers, 1)
old.P0:Destroy()
old.P1:Destroy()
if old.Impact then old.Impact:Destroy() end
end
end
local function ClearTracers()
Ghost.OutsideShots.Clear()
for _,tracer in ipairs(ActiveTracers) do
tracer.P0:Destroy(); tracer.P1:Destroy()
if tracer.Impact then tracer.Impact:Destroy() end
end
table.clear(ActiveTracers)
end
function ShotDetector.Deliver()
if not Settings.Tracer.Enabled or ShotDetector.Paused() then return end
local tool=ShotDetector.ConfirmedTool
if tool and tool.Parent~=LocalPlayer.Character then return end
local candidate=ShotDetector.Candidate
local recent=candidate and candidate.Tool==tool and math.abs(candidate.At-ShotDetector.ConfirmedAt)<0.015
local origin=ShotDetector.ConfirmedOrigin
if not origin and Settings.Tracer.Origin=="Tool" and recent and candidate.VerifiedWeaponOrigin then
origin=candidate.Origin
end
if not origin then
ShotDetector.TracersSkipped=(ShotDetector.TracersSkipped or 0)+1
return
end
local hit=recent and candidate.Position or nil
if not hit then
local camera=Workspace.CurrentCamera
if not camera then return end
local mouse=UserInputService:GetMouseLocation()
local aimRay=camera:ScreenPointToRay(mouse.X,mouse.Y)
local excluded={camera,TracerFolder}
if LocalPlayer.Character then table.insert(excluded,LocalPlayer.Character) end
local range=Settings.Tracer.Range
rayParams.FilterDescendantsInstances=excluded
local aimHit=Workspace:Raycast(aimRay.Origin,aimRay.Direction*range,rayParams)
local aimPoint=aimHit and aimHit.Position or aimRay.Origin+aimRay.Direction*range
local delta=aimPoint-origin
if delta.Magnitude<0.001 then return end
local result=Workspace:Raycast(origin,delta,rayParams)
hit=result and result.Position or aimPoint
end
SpawnTracer(origin,hit)
local visual=ActiveTracers[#ActiveTracers]
visual.ShotId=LastShotId
visual.Tool=tool; visual.ShotAt=ShotDetector.ConfirmedAt; visual.Exact=recent and candidate.Exact or false
ShotDetector.LastVisual=visual
end
function Ghost.OutsideShots.Draw(origin,position,shot,id)
while #ActiveTracers>=64 do
local oldest=table.remove(ActiveTracers,1)
oldest.P0:Destroy();oldest.P1:Destroy();if oldest.Impact then oldest.Impact:Destroy() end
end
SpawnTracer(origin,position)
local visual=ActiveTracers[#ActiveTracers]
if visual then visual.ShotId=id;visual.Tool=shot.Model;visual.ShotAt=shot.At;visual.Exact=true;visual.Outside=true end
end
local function UpdateTracers()
ShotDetector.Tick()
Ghost.OutsideShots.Flush(Ghost.OutsideShots.Draw)
local now=os.clock()
local T=Settings.Tracer
if not T.Enabled or Settings.Freecam.Enabled then
ClearTracers(); ShotDetector.LastVisual=nil; return
end
for i=#ActiveTracers,1,-1 do
local t=ActiveTracers[i]
local a=(now-t.Born)/t.Life
if a>=1 or not t.P0.Parent or not t.P1.Parent then
t.P0:Destroy(); t.P1:Destroy()
if t.Impact then t.Impact:Destroy() end
table.remove(ActiveTracers,i)
else
t.Halo.Transparency=NumberSequence.new(0.7+0.3*a)
t.Mid.Transparency=NumberSequence.new(a*a)
if t.Core then t.Core.Transparency=NumberSequence.new(0.1+0.9*a) end
if t.Impact then
local size=0.4+a*1.6; t.Impact.Size=Vector3.new(size,size,size); t.Impact.Transparency=a
if t.Light then t.Light.Brightness=3*(1-a) end
end
end
end
end
