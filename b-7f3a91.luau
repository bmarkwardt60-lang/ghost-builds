local words={"inventory","shop","store","locker","loadout","weapon","skin","cosmetic","purchase","equip","owned","itemdata","catalog","armory","crate","case","remote","network"}
local function score(name)
local n=name:lower();local value=0
for _,word in ipairs(words) do if n:find(word,1,true) then value+=10 end end
if n:find("inventory",1,true) or n:find("shop",1,true) or n:find("loadout",1,true) then value+=30 end
return value
end
local function path(object)
