if asset:IsA("Accessory") or asset:IsA("Shirt") or asset:IsA("Pants") or asset:IsA("ShirtGraphic") then return "Character" end
if asset:FindFirstChildWhichIsA("VehicleSeat",true) then return "Vehicle" end
local path=asset:GetFullName():gsub("(%l)(%u)","%1 %2"):lower()
local metadata=""
for _,name in ipairs({"Category","AssetType","ItemType","AttachmentType"}) do
local value=asset:GetAttribute(name)
if type(value)=="string" then
local normalized=value:lower():gsub("[^%a]","")
local aliases={character="Character",avatar="Character",clothing="Character",weapon="Weapon",weapons="Weapon",car="Vehicle",cars="Vehicle",vehicle="Vehicle",vehicles="Vehicle",other="Other"}
if aliases[normalized] then return aliases[normalized] end
metadata ..= " " .. value:gsub("(%l)(%u)","%1 %2"):lower()
end
end
local text=(metadata .. " " .. path):gsub("[^%a%d]"," ")
local words={}
for word in text:gmatch("%S+") do words[word]=true end
for _,word in ipairs({"weapon","weapons","gun","guns","rifle","rifles","pistol","pistols","sword","swords","knife","knives","blade","blades","bow","bows","attachments","attachment","scope","scopes","optic","barrel","muzzle","silencer","suppressor","silencieux","grip","magazine","ammo","stock"}) do if words[word] then return "Weapon" end end
for _,word in ipairs({"car","cars","vehicle","vehicles","chassis","truck","trucks","bike","motorcycle","boat","boats","aircraft","plane","planes","helicopter","wheel","wheels","rim","rims","tire","tires","tyre","tyres","bumper","spoiler","chassis","exhaust"}) do if words[word] then return "Vehicle" end end
for _,word in ipairs({"character","characters","avatar","avatars","outfit","outfits","clothing","clothes","hair","hat","hats","face","accessory","accessories","armor","armour","shirt","shirts","pants","jacket","jackets","helmet","helmets","shoes"}) do if words[word] then return "Character" end end
