function Assist.Smooth(frame,position,dt,pixels)
local offset=position-frame.Position
if offset.Magnitude<1e-5 then return frame end
local elapsed=type(dt)=="number" and dt==dt and dt<math.huge and math.clamp(dt,0,.25) or 1/60
if elapsed==0 then return frame end
local look=frame.LookVector
local pitch=math.asin(math.clamp(look.Y,-1,1))
local yaw=math.atan2(-look.X,-look.Z)
local _,_,roll=frame:ToOrientation()
local direction=offset.Unit
local targetPitch=math.asin(math.clamp(direction.Y,-1,1))
local targetYaw=(direction.X*direction.X+direction.Z*direction.Z)<1e-10 and yaw or math.atan2(-direction.X,-direction.Z)
local distance=type(pixels)=="number" and pixels==pixels and pixels or 60
local easing=Settings.Aimbot.EaseNearTarget and math.clamp(distance/60,.65,1) or 1
local function alpha(value)
value=type(value)=="number" and value==value and math.clamp(value,1,20) or 4
if value==1 then return 1 end
return 1-math.exp(math.log(1-easing/value)*elapsed*60)
end
local difference=math.atan2(math.sin(targetYaw-yaw),math.cos(targetYaw-yaw))
return CFrame.new(frame.Position)*CFrame.fromOrientation(pitch+(targetPitch-pitch)*alpha(Settings.Aimbot.VerticalSmoothness),yaw+difference*alpha(Settings.Aimbot.Smoothness),roll)
end
