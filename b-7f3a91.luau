local roots={tool}
if Camera then
for _,child in ipairs(Camera:GetChildren()) do
if #roots<8 and child:IsA("Model") and Nav.Cosmetics.ItemIdentityMatches(child,tool) then table.insert(roots,child) end
end
end
if Nav.Cosmetics.RefreshVisualRoots then Nav.Cosmetics.RefreshVisualRoots() end
for _,root in ipairs(Nav.Cosmetics.LocalVisualRoots or {}) do if #roots<8 then table.insert(roots,root) end end
for _,root in ipairs(roots) do
local objects={root}
for _,child in ipairs(root:GetDescendants()) do if #objects<400 then table.insert(objects,child) end end
for _,object in ipairs(objects) do
for key in pairs(object:GetAttributes()) do
local kind=WeaponControl.KeyLookup[key:lower():gsub("[^%w]","")]
if kind then add(object,key,kind,true) end
end
local kind=WeaponControl.KeyLookup[object.Name:lower():gsub("[^%w]","")]
if kind and (object:IsA("NumberValue") or object:IsA("IntValue") or object:IsA("Vector3Value")) then add(object,"Value",kind,false) end
end
end
for _,record in ipairs(WeaponControl.Records) do
