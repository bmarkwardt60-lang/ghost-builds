swatch.BackgroundColor3 = c
svFrame.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
svCursor.Position = UDim2.fromScale(sat, 1 - val)
hueCursor.Position = UDim2.new(0.5, 0, h, 0)
if save then RequestSave() end
end
local drag = nil
local function update()
local m = UserInputService:GetMouseLocation()
if drag == "sv" then
sat = math.clamp((m.X - svFrame.AbsolutePosition.X) / svFrame.AbsoluteSize.X, 0, 1)
val = 1 - math.clamp((m.Y - svFrame.AbsolutePosition.Y) / svFrame.AbsoluteSize.Y, 0, 1)
apply(true)
elseif drag == "hue" then
h = math.clamp((m.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 0.999)
apply(true)
end
end
local function isPress(input)
return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end
Connect(svFrame.InputBegan, function(input) if isPress(input) then drag = "sv"; update() end end)
Connect(hueBar.InputBegan, function(input) if isPress(input) then drag = "hue"; update() end end)
Connect(UserInputService.InputChanged, function(input)
if drag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
update()
end
end)
Connect(UserInputService.InputEnded, function(input) if isPress(input) then drag = nil end end)
local open = false
