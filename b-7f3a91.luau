end
function A.Report()
local state=A.State
if not state then return "Inactive; ammo and saved ownership unchanged." end
local result={"Native local attachment inputs applied"}
if state.Mods.Muzzle then table.insert(result,state.Silenced and "Suppressor: native local audio/flash flag" or "Muzzle: local appearance") end
if state.Mods.Optic then table.insert(result,"Optic: native aim/zoom settings") end
if state.Mods.Rail then table.insert(result,A.Rails[state.Mods.Rail] and "Rail: bounded local laser/light" or "Rail: appearance only") end
if state.Mods.Mag then table.insert(result,state.CapacityMapped and ("Magazine: native local capacity "..tostring(state.Capacity).."; loaded ammo remains native") or "Magazine: appearance only; native capacity mapping unavailable") end
if state.CapacityError then table.insert(result,state.CapacityError) end
if state.Mods.Stock then table.insert(result,"Stock: appearance only; roll-speed benefit unverified") end
if state.Mods.Underbarrel then
local item=state.Catalog.Items[state.Mods.Underbarrel]
table.insert(result,item and item.SpreadScale and "Grip: native local spread setting" or "Grip: appearance only")
end
table.insert(result,"Saved ownership unchanged; other clients' audio is not controlled")
if A.LastError then table.insert(result,"Last local effect error: "..A.LastError) end
return table.concat(result,"; ")
end
