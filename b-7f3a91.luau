function Ghost.SectionHeight(group)
local height,count=18,0
for _,row in ipairs(group:GetChildren()) do
if row:IsA("GuiObject") and row.Visible then
local size=row.Size
height+=size.Y.Scale==0 and size.Y.Offset or row.AbsoluteSize.Y/math.max(MainScale.Scale,0.1)
count+=1
end
end
return math.max(48,height+math.max(0,count-1)*3)
end
function Ghost.ExpandSection(group: any)
local token=(Ghost.Marked(group,"Expand") or 0)+1
Ghost.Mark(group,"Expand",token)
local target=Ghost.SectionHeight(group)
local from=group.AutomaticSize==Enum.AutomaticSize.None and group.Size.Y.Offset or 48
if Ghost.Reduced() then group.AutomaticSize=Enum.AutomaticSize.Y; group.Size=UDim2.new(1,0,0,0); group.ClipsDescendants=false; return end
group.AutomaticSize=Enum.AutomaticSize.None; group.ClipsDescendants=true
group.Size=UDim2.new(1,0,0,math.max(48,from))
Tween(group,0.27,{Size=UDim2.new(1,0,0,target)},Enum.EasingStyle.Quint)
task.delay(0.28,function()
if not group.Parent or Ghost.Marked(group,"Expand")~=token then return end
group.AutomaticSize=Enum.AutomaticSize.Y; group.Size=UDim2.new(1,0,0,0); group.ClipsDescendants=false
end)
end
Nav.Collapsed = {}
function Nav.Expand(group)
local hidden = Nav.Collapsed[group]
if hidden then
for row,visible in pairs(hidden) do if row.Parent then row.Visible = visible end end
Nav.Collapsed[group] = nil
Ghost.ExpandSection(group)
local header = group:FindFirstChildOfClass("TextLabel")
local toggle = header and header:FindFirstChild("Collapse")
if toggle then Icons.Section(toggle,true) end
end
end
