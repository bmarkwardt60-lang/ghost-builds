}, track)
Corner(fill, 3)
local knob = New("Frame", {
AnchorPoint = Vector2.new(0.5, 0.5),
Size = UDim2.fromOffset(12, 12),
BackgroundColor3 = Theme.Accent,
ZIndex = 2,
}, track)
Corner(knob, 7)
Stroke(knob, Theme.Element, 1)
local function setValue(v, fire)
v = math.clamp(math.floor(v / step + 0.5) * step, min, max)
v = tonumber(string.format("%.4f", v)) or v
value = v
local a = (v - min) / (max - min)
fill.Size = UDim2.new(a, 0, 1, 0)
knob.Position = UDim2.new(a, 0, 0.5, 0)
valueLabel.Text = tostring(v) .. TR(suffix or "")
if fire then callback(v); RequestSave() end
end
Connect(valueLabel.FocusLost,function()
local number = tonumber(valueLabel.Text:match("%-?%d*%.?%d+"))
setValue(number or value,number ~= nil)
end)
row.Selectable = true
Connect(UserInputService.InputBegan,function(input)
if UserInputService:GetFocusedTextBox() then return end
local selected = game:GetService("GuiService").SelectedObject
if selected == row then
if input.KeyCode == Enum.KeyCode.Left or input.KeyCode == Enum.KeyCode.DPadLeft then setValue(value-step,true) end
if input.KeyCode == Enum.KeyCode.Right or input.KeyCode == Enum.KeyCode.DPadRight then setValue(value+step,true) end
end
end)
local dragging = false
local function update(x)
local a = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
setValue(min + (max - min) * a, true)
end
Connect(row.InputBegan, function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
if input.Position.Y < track.AbsolutePosition.Y-12 then return end
dragging = true
Tween(knob,0.12,{Size=UDim2.fromOffset(16,16)},Enum.EasingStyle.Quad)
update(input.Position.X)
end
end)
Connect(UserInputService.InputChanged, function(input)
if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
update(input.Position.X)
end
end)
Connect(UserInputService.InputEnded, function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
dragging = false
Tween(knob,0.18,{Size=UDim2.fromOffset(12,12)},Enum.EasingStyle.Back)
end
end)
table.insert(LocRefresh, function() setValue(value, false) end)
setValue(default, true)
end
local function SameValue(a, b)
if typeof(a) == "Color3" and typeof(b) == "Color3" then return a:ToHex() == b:ToHex() end
return a == b
end
