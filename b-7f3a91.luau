if not ok or type(decoded)~="table" then return nil,"Unlocks JSON could not be read; no changes made." end
for index,value in pairs(decoded) do
if type(index)~="number" or index<1 or index%1~=0 or type(value)~="string" then return nil,"Unlocks list format changed; no changes made." end
table.insert(values,value);seen[value]=true
end
