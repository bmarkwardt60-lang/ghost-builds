if mod and models then
for weapon in pairs(owned) do
local folder=models:FindFirstChild(weapon)
if folder and folder:FindFirstChild(mod,true) then compatible=true;break end
end
end
if compatible then table.insert(ids,id) end
end
end
table.sort(ids)
if #ids==0 then return nil,"No supported attachment/camo IDs were found." end
U.CatalogData=data
