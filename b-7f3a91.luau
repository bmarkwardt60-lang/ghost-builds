if active.Pointer.UserInputType==Enum.UserInputType.Touch then if input~=active.Pointer then return end
elseif input.UserInputType~=Enum.UserInputType.MouseMovement then return end
local dx,dy=input.Position.X-active.Point.X,input.Position.Y-active.Point.Y
if not active.Moved and dx*dx+dy*dy<36 then return end
active.Moved=true; active.Item.SuppressUntil=os.clock()+0.25
local x,y=Nav.Hud.Clamp(active.Item,active.Position.X.Offset+dx,active.Position.Y.Offset+dy)
active.Item.Object.Position=UDim2.fromOffset(x,y)
end)
Connect(UserInputService.InputEnded,function(input)
local active=Nav.Hud.Active
if not active then return end
if active.Pointer.UserInputType==Enum.UserInputType.Touch then if input~=active.Pointer then return end
elseif input.UserInputType~=Enum.UserInputType.MouseButton1 then return end
Nav.Hud.Finish()
end)
