local success,data=pcall(loader,module)
if not success or type(data)~="table" or type(data.TIER)~="table" or type(data.Unlocked)~="function" then return nil,"Attachment catalog format changed; adapter needs updating." end
local ids={}
local owned=Ghost.OwnedWeaponIds()
if next(owned)==nil then return nil,"Equip or carry an owned weapon before unlocking its cosmetic options." end
local models=storage:FindFirstChild("WeaponMods")
for id in pairs(data.TIER) do
if type(id)=="string" and #id<=160 then
local mod=id:match("^Mod:(.+)")
