function A.PrimeRail(copy,mods)
local id=mods.Rail
local kind=id and A.Rails[id]
local root=kind and copy:FindFirstChild("Mod_"..id)
if not root then return end
local count=0
for _,part in ipairs(root:GetDescendants()) do
if not part:IsA("BasePart") or part.Name~=kind then continue end
if count>=(kind=="Laser" and 2 or 1) then break end
local start,finish=part:FindFirstChild("1"),part:FindFirstChild("2")
if not start or not finish or not start:IsA("Attachment") or not finish:IsA("Attachment") then continue end
local delta=finish.Position-start.Position
if delta.Magnitude<.001 then continue end
local beam
for _,candidate in ipairs(part:GetChildren()) do
if candidate:IsA("Beam") and candidate.Attachment0==start and candidate.Attachment1==finish then beam=candidate;break end
end
if not beam then continue end
count+=1;Ghost.Mark(beam,"RailEffect",true)
Ghost.Mark(beam,"RailDirection",delta.Unit)
Ghost.Mark(beam,"RailRange",kind=="Laser" and 150 or 60)
if kind=="Laser" then beam.Width0=math.min(beam.Width0,.035);beam.Width1=math.min(beam.Width1,.035) end
if kind=="Light" then
local emitter=part:FindFirstChild("LightEmitter") or Instance.new("Attachment");emitter.Name="LightEmitter"
emitter.CFrame=CFrame.lookAt(start.Position,start.Position+delta.Unit);emitter.Parent=part
local light=emitter:FindFirstChild("AttachmentLight") or Instance.new("SpotLight");light.Name="AttachmentLight"
Ghost.Mark(light,"RailEffect",true);light.Angle=50;light.Range=60;light.Brightness=2;light.Shadows=false
light.Color=id=="FlashlightRed" and Color3.fromRGB(255,60,60) or id=="FlashlightGreen" and Color3.fromRGB(60,255,90) or Color3.new(1,1,1)
light.Parent=emitter
end
end
end
function A.BindRails(context)
