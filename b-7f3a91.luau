local Runtime=(function()
local function createRuntime()
local Runtime = {alive = true, connections = {}, tasks = {}, cleanups = {}}
function Runtime.connect(signal, callback)
local connection = signal:Connect(callback)
Runtime.connections[#Runtime.connections + 1] = connection
return connection
end
function Runtime.spawn(callback)
local thread
thread = task.defer(function()
local ok, problem = xpcall(callback, debug.traceback)
Runtime.tasks[coroutine.running()] = nil
if not ok and Runtime.alive then warn('[Ghost Fling] ' .. tostring(problem)) end
end)
Runtime.tasks[thread] = true
return thread
end
function Runtime.after(seconds, callback)
return Runtime.spawn(function()
task.wait(seconds)
if Runtime.alive then callback() end
end)
end
function Runtime.destroy()
if not Runtime.alive then return end
Runtime.alive = false
for _, connection in ipairs(Runtime.connections) do connection:Disconnect() end
Runtime.connections = {}
local cleanups=Runtime.cleanups
Runtime.cleanups={}
for index = #cleanups, 1, -1 do
local cleanup=cleanups[index]; cleanups[index]=nil; pcall(cleanup)
end
for thread in pairs(Runtime.tasks) do
if thread ~= coroutine.running() then pcall(task.cancel, thread) end
end
Runtime.tasks = {}
end
return Runtime
end
return createRuntime()
end)()
local Model=(function()
local Model = {}
function Model.normalize(text)
return ((tostring(text or ''):lower():match('^%s*(.-)%s*$') or ''):gsub('^@', ''))
end
function Model.byId(players, userId)
for _, player in ipairs(players) do
if player.UserId == userId then return player end
end
return nil
end
function Model.filter(players, query, localId)
query = Model.normalize(query)
local matches = {}
for _, player in ipairs(players) do
if player.UserId ~= localId and (query == ''
or player.Name:lower():find(query, 1, true)
or player.DisplayName:lower():find(query, 1, true)) then
matches[#matches + 1] = player
end
end
table.sort(matches, function(a, b)
local first, second = a.DisplayName:lower(), b.DisplayName:lower()
if first == second then return a.UserId < b.UserId end
return first < second
end)
return matches
end
function Model.resolve(players, query, localId)
query = Model.normalize(query)
if query == '' then return nil, 'Select or enter a player' end
local exact = {}
for _, player in ipairs(players) do
if player.UserId ~= localId then
if player.Name:lower() == query then return player end
if player.DisplayName:lower() == query then exact[#exact + 1] = player end
end
end
if #exact == 1 then return exact[1] end
if #exact > 1 then return nil, 'Choose a player from the list' end
local matches = Model.filter(players, query, localId)
if #matches == 1 then return matches[1] end
return nil, #matches > 1 and 'Choose a player from the list' or 'Player not found'
end
return Model
end)()
