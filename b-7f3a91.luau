for _,object in ipairs(context.Copy:GetDescendants()) do
if object:IsA("Beam") and Ghost.Marked(object,"RailEffect")==true then
local a,b=object.Attachment0,object.Attachment1
local direction=Ghost.Marked(object,"RailDirection")
if a and b and a.Parent==b.Parent and a:IsDescendantOf(context.Copy) and b:IsDescendantOf(context.Copy) and typeof(direction)=="Vector3" then
table.insert(context.RailEffects,{Beam=object,Start=a,Finish=b,Direction=direction,Range=Ghost.Marked(object,"RailRange") or 150})
if #context.RailEffects>=2 then break end
end
end
end
end
function A.UpdateRails(context,owner)
if not context.Copy.Parent or #(context.RailEffects or {})==0 or os.clock()<(context.NextRail or 0) then return end
context.NextRail=os.clock()+.05
local params=context.RailParams
if not params then params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.IgnoreWater=true;context.RailParams=params end
local excluded={owner.Character,owner.Target,owner.Copy}
local folder=Workspace:FindFirstChild("ArmoryPreview");if folder then table.insert(excluded,folder) end
params.FilterDescendantsInstances=excluded
for _,record in ipairs(context.RailEffects) do
if not record.Beam.Parent or not record.Start.Parent or not record.Finish.Parent then continue end
local origin=record.Start.WorldPosition
local direction=record.Start.Parent.CFrame:VectorToWorldSpace(record.Direction)
local hit=Workspace:Raycast(origin,direction*record.Range,params)
local distance=hit and (hit.Position-origin).Magnitude or record.Range
record.Finish.Position=record.Start.Position+record.Direction*math.clamp(distance,0,record.Range)
end
