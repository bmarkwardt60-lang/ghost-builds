function Nav.Index()
Nav.Entries = {}
for _,name in ipairs({"Aim","Silent","Visuals","Chams","Extras","Player","Misc","Cosmetics","Account","Awareness","Camera","Crates","Trails"}) do
local tab = Tabs[name]
for _,group in ipairs(Nav.Cards(tab.Page)) do
if group:IsA("Frame") and group.AutomaticSize == Enum.AutomaticSize.Y then
for _,row in ipairs(group:GetChildren()) do
if row:IsA("TextButton") or row:IsA("Frame") then
local label = nil
if row:IsA("TextButton") and row.Text ~= "" then label = row end
if not label then
for _,child in ipairs(row:GetDescendants()) do
if child:IsA("TextLabel") and child.Text ~= "" then label = child; break end
end
end
if label then
table.insert(Nav.Entries,{Tab=name,Row=row,Label=label})
end
end
end
end
end
end
end
