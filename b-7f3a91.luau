end
function Awareness.Tick()
local config=Settings.Awareness
if not Alive or Settings.Freecam.Enabled or not Camera or not LocalPlayer.Character or (not config.ArrowsEnabled and not config.WarningEnabled) then Awareness.Clear(); return end
local localPart=LocalPlayer.Character:FindFirstChild("Head") or LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
if not localPart then Awareness.Clear(); return end
local seen={}
local best,bestDot,bestMode=nil,-1,nil
for _,player in ipairs(Players:GetPlayers()) do
if player~=LocalPlayer then
local character=player.Character
local humanoid=character and character:FindFirstChildOfClass("Humanoid")
local root=character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head"))
if root and humanoid and humanoid.Health>0 and not (config.TeamCheck and IsTeammate(player)) then
seen[player]=true
local distance=(root.Position-localPart.Position).Magnitude
local screen,onScreen=Camera:WorldToViewportPoint(root.Position)
onScreen=onScreen and screen.Z>0
if config.ArrowsEnabled and not onScreen and distance<=config.ArrowDistance then
local arrow=Awareness.Arrow(player)
local edge,angle=Awareness.Edge(Camera.CFrame:PointToObjectSpace(root.Position),Camera.ViewportSize)
arrow.Root.Position=UDim2.fromOffset(edge.X,edge.Y); arrow.Root.Visible=true
arrow.Icon.Rotation=angle; Icons.Tint(arrow.Icon,config.ArrowColor)
arrow.Distance.Text=string.format("%.0f st",distance); arrow.Distance.TextColor3=config.ArrowColor
arrow.Scale.Scale=math.clamp(config.ArrowScale/100,0.6,1.8); arrow.Distance.Visible=config.ArrowShowDistance
elseif Awareness.Arrows[player] then Awareness.Arrows[player].Root.Visible=false end
local threat=false
local mode=nil
local dot=-1
local tool=character:FindFirstChildOfClass("Tool")
if config.WarningEnabled and distance<=config.WarningDistance and (not config.ArmedOnly or tool) then
local origin,direction,source=Awareness.Direction(character,tool)
if origin and direction and direction.Magnitude>0.001 then
local points={localPart}
for _,name in ipairs({"UpperTorso","Torso","HumanoidRootPart"}) do
local point=LocalPlayer.Character:FindFirstChild(name)
if point and point~=localPart then table.insert(points,point) end
end
for _,point in ipairs(points) do
local delta=point.Position-origin
if delta.Magnitude>0.001 then
local alignment=direction.Unit:Dot(delta.Unit)
local near=alignment>=math.cos(math.rad(config.WarningAngle))
if near and config.RequireLOS then near=Awareness.LineOfSight(origin,point.Position,character) end
if near and alignment>dot then dot=alignment; mode=source; threat=true end
end
end
end
end
if threat then
Awareness.Dwell[player]=Awareness.Dwell[player] or os.clock()
if os.clock()-Awareness.Dwell[player]>=config.WarningDwell and dot>bestDot then best=player; bestDot=dot; bestMode=mode end
else Awareness.Dwell[player]=nil end
else Awareness.Remove(player) end
end
end
for player in pairs(Awareness.Arrows) do if not seen[player] then Awareness.Remove(player) end end
for player in pairs(Awareness.Dwell) do if not seen[player] then Awareness.Dwell[player]=nil end end
if not Awareness.Warning then
Awareness.Warning=New("TextLabel",{AnchorPoint=Vector2.new(0.5,0),Position=UDim2.new(0.5,0,0,56),Size=UDim2.new(0,340,0,50),BackgroundColor3=Theme.Sidebar,BackgroundTransparency=0.12,BorderSizePixel=0,Text="",TextWrapped=true,Font=Enum.Font.GothamBold,TextSize=13,TextColor3=Color3.fromRGB(255,190,80),Visible=false,ZIndex=40},ScreenGui)
