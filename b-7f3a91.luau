function Ghost.Art.API()
local environment: {[string]:any}=getfenv()
local function read(scope,key)
if type(scope)~="table" then return nil end
local ok,value=pcall(function() return scope[key] end)
return ok and value or nil
end
local shared=environment
local getShared=read(environment,"getgenv")
if type(getShared)=="function" then local ok,value=pcall(getShared); if ok and type(value)=="table" then shared=value end end
local api: {[string]:any}={}
local function take(key,value)
if type(api[key])~="function" and type(value)=="function" then api[key]=value end
end
for _,scope in ipairs({environment,shared}) do
take("Write",read(scope,"writefile")); take("Read",read(scope,"readfile")); take("Exists",read(scope,"isfile"))
take("Image",read(scope,"getcustomasset")); take("Image",read(scope,"getsynasset"))
local crypt=read(scope,"crypt")
take("Decode",read(crypt,"base64decode")); take("Decode",read(read(crypt,"base64"),"decode"))
end
return api
end
function Ghost.Art.Decode(value: string,api: any): string
if type(api.Decode)=="function" then
local ok,decoded=pcall(api.Decode,value)
if ok and type(decoded)=="string" and decoded:sub(1,8)=="\137PNG\r\n\26\n" then return decoded end
end
assert(#value%4==0,"Invalid embedded artwork")
local alphabet="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local map: {[number]:number}={}
for i=1,64 do map[alphabet:byte(i)]=i-1 end
local out=table.create(#value/4)
for i=1,#value,4 do
