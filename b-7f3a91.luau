end
local descriptions={}
for reason,count in pairs(rejected) do table.insert(descriptions,reason .. ": " .. count) end
table.sort(descriptions)
Assist.Reasons[channel]=#descriptions>0 and table.concat(descriptions,", ") or "No other players"
