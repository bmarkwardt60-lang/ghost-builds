function Ghost.ModelBounds(model)
local low,high
for _,part in ipairs(model:GetDescendants()) do
if part:IsA("BasePart") and (part.Transparency or 0)<.99 and part.Name~="HumanoidRootPart" then
local frame,half=part.CFrame,part.Size*.5
