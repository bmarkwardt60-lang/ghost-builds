function Awareness.Direction(character,tool)
if tool then
local cached=Awareness.Points and Awareness.Points[tool]
if not Awareness.Points then Awareness.Points=setmetatable({},{__mode="k"}) end
if not cached or (cached.Point and not cached.Point.Parent) or os.clock()-cached.At>1 then
local point
for _,name in ipairs({"Muzzle","MuzzleTip","MuzzleAttachment","FirePoint","BulletOrigin","ShootPoint","FireAttachment","BarrelTip"}) do
local found=tool:FindFirstChild(name,true)
if found and (found:IsA("Attachment") or found:IsA("BasePart")) then point=found; break end
end
cached={Point=point,At=os.clock()}; Awareness.Points[tool]=cached
end
local point=cached.Point
if point then
local frame=point:IsA("Attachment") and point.WorldCFrame or point.CFrame
local direction=frame.LookVector
local handle=tool:FindFirstChild("Handle")
if handle and handle:IsA("BasePart") then
local outward=frame.Position-handle.Position
if outward.Magnitude>0.25 then
local best=-1
for _,axis in ipairs({frame.LookVector,frame.RightVector,frame.UpVector}) do
local alignment=axis:Dot(outward.Unit)
if math.abs(alignment)>best then direction=axis*(alignment>=0 and 1 or -1); best=math.abs(alignment) end
end
end
end
return frame.Position,direction,"weapon direction estimate"
end
end
local head=character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
if head then return head.Position,head.CFrame.LookVector,"head estimate" end
