function Crates.Summarize(value: any,depth: number?,seen: {[any]:any}?): string
local level: number=depth or 0
local visited: {[any]:any}=seen or {}
visited.Nodes=(visited.Nodes or 0)+1
if visited.Nodes>180 then return "<node budget>" end
local kind=type(value)
if kind=="string" then return string.format("%q",value:sub(1,160)) end
if kind=="number" or kind=="boolean" or kind=="nil" then return tostring(value) end
if kind~="table" then return "<" .. typeof(value) .. ">" end
if visited[value] then return "<cycle>" end
if level>=4 then return "<table>" end
visited[value]=true
local entries: {string}={}
local keys: {[any]:boolean}={}
local function append(key: any,field: any): ()
if keys[key] or #entries>=24 then return end
keys[key]=true
local name=tostring(key):sub(1,60)
local lower=name:lower()
if lower:find("token",1,true) or lower:find("signature",1,true) or lower:find("nonce",1,true) or lower:find("secret",1,true) or lower:find("auth",1,true) or lower:find("session",1,true) then
table.insert(entries,name .. "=<redacted>")
else table.insert(entries,name .. "=" .. Crates.Summarize(field,level+1,visited)) end
end
local priorityFields: {number|string}={1,"ok","err","error","item","Item","reward","Reward","winner","Winner","result","Result","data","Data","itemId","rewardId","rarity","Rarity","tier","name","caseId","crateId"}
for _,key in ipairs(priorityFields) do
local field=rawget(value,key)
if field~=nil then append(key,field) end
end
for key,field in pairs(value) do
if #entries>=24 then table.insert(entries,"..."); break end
append(key,field)
end
visited[value]=nil
return ("{" .. table.concat(entries,", ") .. "}"):sub(1,3000)
end
