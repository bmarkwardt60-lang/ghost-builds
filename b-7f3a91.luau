function Nav.Hud.Clamp(item,x,y)
local view=Nav.Hud.Viewport()
local size=item.Object.AbsoluteSize
local width=math.max(size.X,item.Object.Size.X.Offset,1)
local height=math.max(size.Y,item.Object.Size.Y.Offset,1)
return math.clamp(x,0,math.max(0,view.X-width)),math.clamp(y,0,math.max(0,view.Y-height)),math.max(1,view.X-width),math.max(1,view.Y-height)
end
function Nav.Hud.Layout(item)
local saved=type(Settings.UI.HudPositions)=="table" and Settings.UI.HudPositions[item.Name]
local x,y=item.X,item.Y
if type(saved)=="table" and type(saved.X)=="number" and type(saved.Y)=="number" and saved.X==saved.X and saved.Y==saved.Y then
local _,_,width,height=Nav.Hud.Clamp(item,0,0)
x=math.clamp(saved.X,0,1)*width; y=math.clamp(saved.Y,0,1)*height
end
x,y=Nav.Hud.Clamp(item,x,y)
item.Object.Position=UDim2.fromOffset(x,y)
end
function Nav.Hud.LayoutAll()
for _,item in pairs(Nav.Hud.Items) do Nav.Hud.Layout(item) end
end
function Nav.Hud.Finish()
local active=Nav.Hud.Active; Nav.Hud.Active=nil
if not active or not active.Moved then return end
local position=active.Item.Object.Position
local x,y,width,height=Nav.Hud.Clamp(active.Item,position.X.Offset,position.Y.Offset)
if type(Settings.UI.HudPositions)~="table" then Settings.UI.HudPositions={} end
Settings.UI.HudPositions[active.Item.Name]={X=x/width,Y=y/height}
active.Item.SuppressUntil=os.clock()+0.25
RequestSave()
end
function Nav.Hud.Register(name,object,x,y)
