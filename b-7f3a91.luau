function Icons.Symbol(parent,name,color,size)
local old=parent:FindFirstChild("ControlIcon"); if old then Icons.Remove(old);old:Destroy() end
local pixels=size or 14
local icon=Icons.Make(parent,name,pixels,color)
icon.Position=UDim2.new(0.5,-pixels/2,0.5,-pixels/2)
parent:SetAttribute("IconName",name)
return icon
end
function Icons.Action(button,name,color)
local ok,result=pcall(function()
local old=button:FindFirstChild("ActionIcon"); if old then Icons.Remove(old);old:Destroy() end
local padding=button:FindFirstChild("ActionPadding")
if not padding then padding=New("UIPadding",{Name="ActionPadding",PaddingLeft=UDim.new(0,36),PaddingRight=UDim.new(0,10)},button) end
button.TextXAlignment=Enum.TextXAlignment.Left
local icon=Icons.Make(button,name,16,color or button.TextColor3 or Theme.Text)
icon.Name="ActionIcon"; icon.Position=UDim2.new(0,-24,0.5,-8)
button:SetAttribute("ActionIcon",name)
return icon
end)
if ok then return result end
Icons.ActionFailures=(Icons.ActionFailures or 0)+1
if not Icons.ActionWarning then
Icons.ActionWarning=true
warn("[Ghost] Optional status icon unavailable; continuing startup: "..tostring(result))
end
return nil
end
function Icons.Section(button,expanded)
local icon=button:FindFirstChild("ControlIcon")
if not icon then icon=Icons.Make(button,"Chevron",12,Theme.SubText); icon.Position=UDim2.fromOffset(6,6) end
button.Text=""; button:SetAttribute("Expanded",expanded)
Tween(icon,0.18,{Rotation=expanded and 0 or -90})
end
Icons.Images={};Icons.Sidebars=Icons.Images
Icons.ByRoot=setmetatable({},{__mode="k"});Icons.NextRefresh=0
function Icons.Native(item)
if item.Drawn then return end
item.Drawn=true
local factor=item.Size/24
for _,path in ipairs(Icons.Paths[item.Role] or Icons.Paths.Help) do
for i=1,#path-1 do
local a,b=path[i],path[i+1];local dx,dy=(b[1]-a[1])*factor,(b[2]-a[2])*factor
local length=math.sqrt(dx*dx+dy*dy)
if length>.01 then
local line=New("Frame",{Name="Ink",AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromOffset((a[1]+b[1])*factor/2,(a[2]+b[2])*factor/2),Size=UDim2.fromOffset(length,math.max(1,2*factor)),Rotation=math.deg(math.atan2(dy,dx)),BackgroundColor3=item.Color,BorderSizePixel=0,Active=false,NoMotion=true},item.Fallback)
Corner(line,2)
end
end
end
end
function Icons.RefreshOne(item)
if not item.Root.Parent then return end
local atlas=Ghost.Art and Ghost.Art.Interface
local cell=atlas and type(atlas.Index)=="table" and atlas.Index[item.Role]
local valid=atlas and type(cell)=="number" and cell==math.floor(cell) and cell>=0 and type(atlas.Count)=="number" and cell<atlas.Count and atlas.Count<=4096
and type(atlas.Columns)=="number" and atlas.Columns>0 and atlas.Columns<=256 and atlas.Columns==math.floor(atlas.Columns)
and type(atlas.Cell)=="number" and atlas.Cell>0 and atlas.Cell<=4096
local uri=valid and Ghost.Art.Assets[atlas.Key]
if uri then
if item.URI~=uri or item.Cell~=cell then
item.URI=uri;item.Cell=cell;item.Image.Image=uri
item.Image.ImageRectSize=Vector2.new(atlas.Cell,atlas.Cell)
item.Image.ImageRectOffset=Vector2.new((cell%atlas.Columns)*atlas.Cell,math.floor(cell/atlas.Columns)*atlas.Cell)
item.Image.Visible=true;Ghost.Art.Warm(item,uri)
end
item.Loaded=item.Image.IsLoaded==true
else
item.Loaded=false;item.URI=nil;item.Cell=nil;item.Image.Visible=false
end
if item.Loaded then
if item.Drawn then for _,child in ipairs(item.Fallback:GetChildren()) do child:Destroy() end;item.Drawn=false end
item.Fallback.Visible=false
else
item.Fallback.Visible=true
if not Ghost.Art or Ghost.Art.Visible(item.Root) then Icons.Native(item) end
end
end
function Icons.RefreshSidebars(force)
local now=os.clock()
if force==false and now<Icons.NextRefresh then return end
Icons.NextRefresh=now+.1
for index=#Icons.Images,1,-1 do
local item=Icons.Images[index]
if not item.Root.Parent then Icons.ByRoot[item.Root]=nil;table.remove(Icons.Images,index)
else
local atlas=Ghost.Art and Ghost.Art.Interface
local unchanged=item.Loaded and atlas and item.URI==Ghost.Art.Assets[atlas.Key] and item.Cell==atlas.Index[item.Role]
if force~=false or not unchanged then
if not Ghost.Art or Ghost.Art.Visible(item.Root) then Icons.RefreshOne(item) end
end
end
end
end
function Icons.Remove(root)
local item=Icons.ByRoot[root];if not item then return end
Icons.ByRoot[root]=nil
for index=#Icons.Images,1,-1 do if Icons.Images[index]==item then table.remove(Icons.Images,index);break end end
end
function Icons.Make(parent,name,size,color)
local role=Icons.Paths[name] and name or "Help"
local root=New("Frame",{Name="ControlIcon",Size=UDim2.fromOffset(size,size),BackgroundTransparency=1,Active=false,NoMotion=true},parent)
root:SetAttribute("IconName",role)
local fallback=New("Frame",{Name="IconFallback",Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Active=false,NoMotion=true},root)
local image=New("ImageLabel",{Name="InterfaceIcon",Size=UDim2.fromScale(1,1),BackgroundTransparency=1,BorderSizePixel=0,Image="",ImageColor3=color,Visible=false,Active=false,ScaleType=Enum.ScaleType.Fit,NoMotion=true},root)
image:SetAttribute("IconInk",true)
local item={Root=root,Image=image,Fallback=fallback,Role=role,Size=size,Color=color,Loaded=false,Drawn=false}
Icons.ByRoot[root]=item;table.insert(Icons.Images,item)
if not Ghost.Art or Ghost.Art.Visible(root) then Icons.RefreshOne(item) end
return root
end
function Icons.Sidebar(parent,name,size,color)
local root=Icons.Make(parent,name,size,color);local item=Icons.ByRoot[root]
item.Image.Name="SidebarIcon";item.Fallback.Name="SidebarFallback"
return root
end
function Icons.Tint(icon,color)
if not icon then return end
local item=Icons.ByRoot[icon]
if item then item.Color=color;item.Image.ImageColor3=color end
for _,part in ipairs(icon:GetDescendants()) do
if part:GetAttribute("IconInk") then part.ImageColor3=color end
if part.Name=="Ink" then
if part:IsA("Frame") then part.BackgroundColor3=color elseif part:IsA("UIStroke") then part.Color=color end
end
end
end
function Icons.ForAction(text)
local value=string.lower(text)
if value:find("copy",1,true) then return "Copy" end
if value:find("restore",1,true) or value:find("reset",1,true) or value:find("clear",1,true) then return "Restore" end
if value:find("retry",1,true) or value:find("refresh",1,true) or value:find("scan",1,true) then return "Refresh" end
if value:find("apply",1,true) or value:find("wear",1,true) then return "Apply" end
if value:find("save",1,true) then return "Save" end
if value:find("load",1,true) and not value:find("unload",1,true) then return "Folder" end
if value:find("unlock",1,true) then return "Shield" end
if value:find("close",1,true) or value:find("unload",1,true) then return "Power" end
if value:find("teleport",1,true) then return "Teleport" end
if value:find("report",1,true) or value:find("details",1,true) then return "Info" end
return "ArrowRight"
end
function Icons.Brand(parent,position,size)
local badge=New("Frame",{Name="GhostMark",Position=position,Size=UDim2.fromOffset(size,size),BackgroundTransparency=1,BorderSizePixel=0},parent)
Corner(badge,math.floor(size*0.28))
if Ghost.Art then Ghost.Art.Mount(badge,"Logo",nil,1,0) end
return badge
end
