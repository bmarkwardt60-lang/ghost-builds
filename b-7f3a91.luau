if Nav.HeaderContext then Nav.HeaderContext.Position=UDim2.fromOffset(narrow and 108 or 240,17); Nav.HeaderContext.Size=UDim2.new(1,narrow and -204 or -340,0,20) end
HintLabel.Visible = false
if Nav.LayoutPages then Nav.LayoutPages() end
MainScale.Scale = MenuFitScale()
Main.Position = UDim2.fromOffset(math.max(0,(size.X-(Main.Size.X.Offset+Ghost.ESPDockWidth())*MainScale.Scale)/2),math.max(0,(size.Y-Main.AbsoluteSize.Y)/2))
if Nav.LayoutCombat then Nav.LayoutCombat() end
if Nav.LayoutPages then Nav.LayoutPages() end
if Nav.Hud then Nav.Hud.Finish(); Nav.Hud.LayoutAll() end
if Nav.LayoutHome then Nav.LayoutHome() end
if Nav.MenuMotion then Nav.MenuMotion.SnapLayout(true) end
end
