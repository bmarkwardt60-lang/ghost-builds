local LEGACY_CONFIG_FILE = "1337Hub_config_" .. tostring((game.GameId and game.GameId~=0) and game.GameId or game.PlaceId) .. ".json"
local CONFIG_FILE = "Ghost_config_" .. tostring((game.GameId and game.GameId~=0) and game.GameId or game.PlaceId) .. ".json"
local CanFS = (typeof(writefile) == "function") and (typeof(readfile) == "function") and (typeof(isfile) == "function")
local ConfigLoaded = false
local function Encode(v)
local t = typeof(v)
if t == "Color3" then
return { __c = v:ToHex() }
elseif t == "EnumItem" then
return { __e = v.Name, __t = (string.match(tostring(v), "^Enum%.(%w+)%.") or "UserInputType") }
end
return v
end
local function Decode(saved, default)
local dt = typeof(default)
if dt == "Color3" then
if type(saved) == "table" and type(saved.__c) == "string" then
local ok, c = pcall(Color3.fromHex, saved.__c)
if ok then return c end
end
return default
elseif dt == "EnumItem" then
if type(saved) == "table" and type(saved.__e) == "string" then
local enumType = (saved.__t == "KeyCode") and Enum.KeyCode or Enum.UserInputType
local ok, e = pcall(function() return enumType[saved.__e] end)
if ok and e then return e end
end
return default
end
if typeof(saved) == dt then return saved end
return default
end
local function SaveConfigNow()
if not CanFS then return false end
local data = {}
for group, tbl in pairs(Settings) do
data[group] = {}
for k, v in pairs(tbl) do data[group][k] = Encode(v) end
end
local ok = pcall(function()
writefile(CONFIG_FILE, HttpService:JSONEncode(data))
end)
return ok
end
local function LoadConfig()
if not CanFS then return end
pcall(function()
local path=isfile(CONFIG_FILE) and CONFIG_FILE or (isfile(LEGACY_CONFIG_FILE) and LEGACY_CONFIG_FILE or "1337Hub_config.json")
if not isfile(path) then return end
local data = HttpService:JSONDecode(readfile(path))
for group, tbl in pairs(Settings) do
local saved = data[group]
if type(saved) == "table" then
for k, default in pairs(tbl) do
if saved[k] ~= nil then tbl[k] = Decode(saved[k], default) end
end
end
end
end)
end
local saveQueued = false
local function RequestSave()
if not ConfigLoaded or saveQueued then return end
saveQueued = true
task.delay(0.6, function()
saveQueued = false
SaveConfigNow()
end)
end
