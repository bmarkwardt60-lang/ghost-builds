function C.Kind(asset)
if asset:IsA("Accessory") then return "Accessory" end
if asset:IsA("Shirt") or asset:IsA("Pants") or asset:IsA("ShirtGraphic") then return asset.ClassName end
if asset:IsA("Tool") then return "Tool model" end
if asset:IsA("Model") and asset:FindFirstChildWhichIsA("BasePart",true) then return "Model" end
if asset:IsA("MeshPart") and not (asset.Parent and (asset.Parent:IsA("Accessory") or asset.Parent:IsA("Tool") or asset.Parent:IsA("Model"))) then return "Mesh" end
if asset:IsA("Decal") or asset:IsA("Texture") then return "Texture" end
return nil
end
function C.Wearable(asset)
if asset:IsA("Shirt") or asset:IsA("Pants") or asset:IsA("ShirtGraphic") then return true end
if asset:IsA("Accessory") and not asset:FindFirstChildWhichIsA("WrapLayer",true) then return true end
return false
end
function C.CloneSafe(source,anchored)
local queue = {source}
local index = 1
while index<=#queue do
if index>1500 then return nil,"This model is too large to preview." end
for _,child in ipairs(queue[index]:GetChildren()) do
if #queue>=1500 then return nil,"This model is too large to preview." end
table.insert(queue,child)
end
index+=1
end
local flags={}
for _,object in ipairs(queue) do flags[object]=object.Archivable; object.Archivable=true end
local ok,clone = pcall(function() return source:Clone() end)
for object,flag in pairs(flags) do pcall(function() object.Archivable=flag end) end
if not ok or not clone then return nil,"This asset cannot be cloned by the client." end
for _,child in ipairs(clone:GetDescendants()) do
if child:IsA("LuaSourceContainer") or child:IsA("JointInstance") or child:IsA("Constraint")
or child:IsA("WeldConstraint") or child:IsA("BodyMover") or child:IsA("RemoteEvent") or child:IsA("RemoteFunction")
or child:IsA("BindableEvent") or child:IsA("BindableFunction") then
child:Destroy()
elseif child:IsA("Sound") then
child.PlayOnRemove=false; child.Playing=false
elseif child:IsA("BasePart") then
child.Anchored = anchored; child.CanCollide = false; child.CanTouch = false; child.CanQuery = false; child.Massless = true; child.LocalTransparencyModifier=0
end
end
if clone:IsA("BasePart") then clone.Anchored=anchored; clone.CanCollide=false; clone.CanTouch=false; clone.CanQuery=false; clone.LocalTransparencyModifier=0 end
return clone,nil
end
function C.Attach(accessory,character,anchored)
local handle = accessory:FindFirstChild("Handle")
if not handle or not handle:IsA("BasePart") then return false,"Accessory has no compatible Handle." end
if accessory:FindFirstChildWhichIsA("WrapLayer",true) then return false,"Layered accessories are preview-only." end
local target,attachment
for _,sourceAttachment in ipairs(handle:GetChildren()) do
if sourceAttachment:IsA("Attachment") then
for _,candidate in ipairs(character:GetDescendants()) do
if candidate:IsA("Attachment") and candidate.Name==sourceAttachment.Name and candidate.Parent:IsA("BasePart") then
target=candidate; attachment=sourceAttachment; break
end
end
end
if target then break end
end
local part = target and target.Parent or character:FindFirstChild("Head")
if not part or not part:IsA("BasePart") then return false,"This character has no compatible attachment point." end
if not target and handle:FindFirstChildOfClass("Attachment") then return false,"This character uses different accessory attachments." end
local original = handle.CFrame
local placement = target and (target.WorldCFrame*attachment.CFrame:Inverse())
or (part.CFrame*CFrame.new(0,0.5,0)*accessory.AttachmentPoint:Inverse())
for _,piece in ipairs(accessory:GetDescendants()) do
if piece:IsA("BasePart") then
local offset = original:ToObjectSpace(piece.CFrame)
piece.CFrame = placement*offset
piece.Anchored = anchored
if piece~=handle then
local weld=Instance.new("Weld"); weld.Part0=handle; weld.Part1=piece; weld.C0=offset; weld.C1=CFrame.new(); weld.Parent=handle
end
end
end
accessory.Parent=character
local weld=Instance.new("Weld"); weld.Name="LocalPreviewWeld"; weld.Part0=part; weld.Part1=handle
weld.C0=part.CFrame:ToObjectSpace(placement); weld.C1=CFrame.new(); weld.Parent=handle
return true,nil
end
