return speed,gravity,false
end
function Assist.Intercept(offset,velocity,speed,gravity,limit)
local a=velocity:Dot(velocity)-speed*speed
local b=2*offset:Dot(velocity)
local c=offset:Dot(offset)
if c<1e-8 then return nil end
local time
if math.abs(a)<1e-8 then
if math.abs(b)>1e-8 then time=-c/b end
else
local d=b*b-4*a*c
if d>=0 then
local q=-.5*(b+(b>=0 and 1 or -1)*math.sqrt(d))
local first,second=q/a,q~=0 and c/q or -1
if first>0 then time=first end
if second>0 and (not time or second<time) then time=second end
end
end
local acceleration=Vector3.new(0,gravity,0)
local function displacement(t) return offset+velocity*t+acceleration*(.5*t*t) end
local function residual(t) local p=displacement(t);return p:Dot(p)-speed*speed*t*t end
local function valid(t)
if not t or t~=t or t<=0 or t>limit then return false end
return math.abs(displacement(t).Magnitude-speed*t)<=math.max(.01,speed*t*1e-5)
end
if gravity<=0 then if valid(time) then return time,displacement(time) end;return nil end
local seed=time and math.clamp(time,1e-6,limit) or math.min(offset.Magnitude/speed,limit)
for _=1,12 do
local p=displacement(seed)
local derivative=2*p:Dot(velocity+acceleration*seed)-2*speed*speed*seed
if math.abs(derivative)<1e-8 then break end
local nextTime=seed-residual(seed)/derivative
if nextTime~=nextTime or nextTime<=0 or nextTime>limit then break end
if math.abs(nextTime-seed)<1e-7 then seed=nextTime;break end
seed=nextTime
end
if valid(seed) then return seed,displacement(seed) end
local low,previous=0,c
for step=1,64 do
local high=limit*(step/64)^2
local value=residual(high)
if value<=0 and previous>=0 then
for _=1,32 do
local middle=(low+high)*.5
if residual(middle)>0 then low=middle else high=middle end
end
local result=(low+high)*.5
if valid(result) then return result,displacement(result) end
return nil
end
low,previous=high,value
end
return nil
end
function Assist.Predict(part: BasePart,origin: Vector3): (Vector3,string)
local config=Settings.Prediction
local position=part.Position
if not config.Enabled then return position,"Prediction off" end
local speed,gravity=config.Speed,config.Gravity
if config.Auto then
local tool=LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
local hitscan
speed,gravity,hitscan=Assist.ProjectileInfo(tool)
if hitscan then return position,"Hitscan metadata · no flight lead" end
if not speed then return position,"Prediction unavailable: projectile speed metadata missing" end
end
if type(speed)~="number" or speed~=speed or speed<=0 or speed>=1000000 then return position,"Invalid projectile speed" end
gravity=type(gravity)=="number" and gravity==gravity and math.clamp(gravity,0,1000) or 0
local root=part.Parent and part.Parent:FindFirstChild("HumanoidRootPart")
local moving=root and root:IsA("BasePart") and root or part
local velocity=moving.AssemblyLinearVelocity
if typeof(velocity)~="Vector3" or velocity.X~=velocity.X or velocity.Y~=velocity.Y or velocity.Z~=velocity.Z or velocity.Magnitude>10000 then return position,"Prediction unavailable: invalid velocity" end
Assist.VelocitySamples=Assist.VelocitySamples or setmetatable({},{__mode="k"})
local now=os.clock()
local previous=Assist.VelocitySamples[moving]
if previous then
local elapsed=now-previous.At
if elapsed>0 and elapsed<.2 and (moving.Position-previous.Position).Magnitude<12+velocity.Magnitude*elapsed and (velocity-previous.Velocity).Magnitude<60 then
velocity=previous.Velocity:Lerp(velocity,1-math.exp(-elapsed/.025))
end
end
Assist.VelocitySamples[moving]={At=now,Position=moving.Position,Velocity=velocity}
local limit=type(config.MaxTime)=="number" and config.MaxTime==config.MaxTime and math.clamp(config.MaxTime,.1,3) or 1
local time,compensated=Assist.Intercept(position-origin,velocity,speed,gravity,limit)
if not time then return position,"No verified intercept within prediction limit" end
return origin+compensated,string.format("Prediction %.0f ms · %.0f st/s",time*1000,speed)
end
