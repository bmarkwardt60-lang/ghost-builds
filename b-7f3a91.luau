if item then
item.Rank=priority=="Distance" and item.Distance or (priority=="Health" and item.Health or item.Pixels)
item.Tie=tostring(actor.UserId or actor.Name or "")
table.insert(ranked,item)
end
end
table.sort(ranked,function(a,b)
if a.Rank~=b.Rank then return a.Rank<b.Rank end
