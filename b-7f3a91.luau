local function CameraStep(dt)
if not Alive or Settings.Freecam.Enabled or Freecam.Running then return end
Freecam.RepairFollow(false)
local cam = Workspace.CurrentCamera
if not cam then return end
if PLR.FOVEnabled then cam.FieldOfView = PLR.FOVValue end
if not TPS.Enabled then
if tpOn then
tpOn = false
RestoreCameraMode()
end
return
end
local c, _hum, hrp = GetChar()
if not c then return end
local head = c:FindFirstChild("Head") or hrp
if not tpOn then
tpOn = true
tpDist = math.max(0.5, (cam.CFrame.Position - head.Position).Magnitude)
if TPS.ForceMode then
pcall(function()
tpSaved = {
Mode = LocalPlayer.CameraMode,
Min  = LocalPlayer.CameraMinZoomDistance,
Max  = LocalPlayer.CameraMaxZoomDistance,
}
LocalPlayer.CameraMode = Enum.CameraMode.Classic
LocalPlayer.CameraMinZoomDistance = 0.5
LocalPlayer.CameraMaxZoomDistance = math.max(128, TPS.Distance + 10)
end)
end
end
local goal = TPS.Distance
if TPS.Smooth then
tpDist = tpDist + (goal - tpDist) * math.clamp(dt * 12, 0, 1)
else
tpDist = goal
end
local origin = head.Position + Vector3.new(0, TPS.Height, 0)
local rot = cam.CFrame - cam.CFrame.Position
local desired = (CFrame.new(origin) * rot):PointToWorldSpace(Vector3.new(TPS.ShoulderX, 0, tpDist))
if TPS.Collision then
tpRay.FilterDescendantsInstances = { c, cam }
local delta = desired - origin
if delta.Magnitude > 0.01 then
local hit = Workspace:Raycast(origin, delta, tpRay)
if hit then
desired = origin + delta.Unit * math.max(0.5, (hit.Position - origin).Magnitude - 0.4)
end
end
end
cam.CFrame = CFrame.new(desired) * rot
if TPS.ShowBody then
for _, d in ipairs(c:GetDescendants()) do
if d:IsA("BasePart") then d.LocalTransparencyModifier = 0 end
end
end
end
RunService:BindToRenderStep("Ghost_Camera", Enum.RenderPriority.Camera.Value + 1, CameraStep)
