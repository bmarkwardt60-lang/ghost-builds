elseif object:IsA("Model") then
local owned=false
for _,key in ipairs({"OwnerUserId","OwnerId","Owner","PlayerUserId"}) do
local value=object:GetAttribute(key)
if value==LocalPlayer.UserId or value==tostring(LocalPlayer.UserId) or value==LocalPlayer.Name then owned=true; break end
local reference=object:FindFirstChild(key)
if reference and reference:IsA("ObjectValue") and (reference.Value==LocalPlayer or reference.Value==character or reference.Value==tool) then owned=true; break end
end
if owned then add(object) end
end
end
for _,scope in ipairs({character or false,camera or false}) do
if scope then for index,object in ipairs(scope:GetDescendants()) do if index>2000 then break end; inspect(object) end end
end
for container in pairs(containers) do
for index,object in ipairs(container:GetDescendants()) do if index>3500 then break end; inspect(object) end
end
local changed=#roots~=#(C.LocalVisualRoots or {})
