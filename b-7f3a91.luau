function Freecam.Step(dt)
if not Alive or not Settings.Freecam.Enabled then if Freecam.Running then Freecam.Stop() end; return end
if not Freecam.Running and not Freecam.Start() then Settings.Freecam.Enabled=false; return end
local saved=Freecam.Saved
local camera=Workspace.CurrentCamera
if not saved or camera~=saved.Camera then Freecam.Disable(); return end
local _,humanoid=GetChar()
if humanoid then humanoid:Move(Vector3.zero,false) end
Freecam.HoldCharacter()
local paused=menuOpen or UserInputService:GetFocusedTextBox()~=nil
local targetVelocity=Vector3.zero
dt=math.clamp(dt,0,0.1)
if paused then
table.clear(Freecam.Held); Freecam.Looking=false; Freecam.Velocity=Vector3.zero
else
if Freecam.Looking then
local delta=UserInputService:GetMouseDelta()
local sensitivity=0.0025*Settings.Freecam.Sensitivity
Freecam.Yaw-=delta.X*sensitivity
Freecam.Pitch=math.clamp(Freecam.Pitch-delta.Y*sensitivity,math.rad(-89),math.rad(89))
end
local keys=Freecam.Held
local function down(key) return keys[key] and 1 or 0 end
local x=down(Enum.KeyCode.D)-down(Enum.KeyCode.A)
local y=down(Enum.KeyCode.E)+down(Enum.KeyCode.Space)-down(Enum.KeyCode.Q)-down(Enum.KeyCode.LeftControl)
local z=down(Enum.KeyCode.W)-down(Enum.KeyCode.S)
local rotation=CFrame.fromOrientation(Freecam.Pitch,Freecam.Yaw,0)
local direction=rotation.RightVector*x+Vector3.new(0,1,0)*y+rotation.LookVector*z
local boost=(keys[Enum.KeyCode.LeftShift] or keys[Enum.KeyCode.RightShift]) and 3 or 1
if direction.Magnitude>0 then targetVelocity=direction.Unit*Settings.Freecam.Speed*boost end
end
local alpha=Settings.Freecam.Smooth and (1-math.exp(-12*dt)) or 1
Freecam.Velocity=Freecam.Velocity:Lerp(targetVelocity,alpha)
Freecam.Position+=Freecam.Velocity*dt
camera.CameraType=Enum.CameraType.Scriptable
camera.CFrame=CFrame.new(Freecam.Position)*CFrame.fromOrientation(Freecam.Pitch,Freecam.Yaw,0)
camera.Focus=camera.CFrame*CFrame.new(0,0,-16)
Freecam.RefreshMouse()
Freecam.Hud.Visible=not menuOpen
Freecam.Hud.Text="FREECAM  ·  " .. Settings.Freecam.Key.Name .. " exit  ·  RMB look  ·  WASD / Q E"
end
RunService:BindToRenderStep(Freecam.Binding,Enum.RenderPriority.Camera.Value+2,function(dt)
local ok,err=pcall(Freecam.Step,dt)
if not ok then Freecam.Disable(); Nav.Notify("Freecam stopped",tostring(err)) end
end)
