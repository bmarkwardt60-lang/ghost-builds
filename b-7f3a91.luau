end)
apply(false)
end
local BindListening = false
local Handles: {[string]: (boolean)->()} = {}
local function BindName(b)
if b == nil or b == Enum.KeyCode.Unknown then return TR("Нет") end
return b.Name
end
local function Keybind(page: any, text: string, tbl: any, key: string): ()
local row = New("Frame", { Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Theme.Element }, page)
Corner(row, 8)
New("TextLabel", {
BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -156, 1, 0),
Font = Enum.Font.GothamMedium, LocKey = text, TextColor3 = Theme.Text, TextSize = 13,
TextXAlignment = Enum.TextXAlignment.Left,
}, row)
local btn = New("TextButton", {
AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(132, 24),
BackgroundColor3 = Theme.Stroke, AutoButtonColor = false, Font = Enum.Font.GothamBold,
TextColor3 = Theme.Text, TextSize = 11, Text = "",
}, row)
Corner(btn, 6)
Icons.Action(btn,"Keyboard",Theme.SubText)
btn:FindFirstChild("ActionPadding").PaddingLeft=UDim.new(0,30)
btn:FindFirstChild("ActionPadding").PaddingRight=UDim.new(0,8)
local listening = false
local function render()
btn.TextColor3=listening and Theme.Background or Theme.Text
Icons.Tint(btn:FindFirstChild("ActionIcon"),listening and Theme.Background or Theme.SubText)
btn.Text = listening and TR("Нажми клавишу…") or (tbl[key]==Enum.KeyCode.Unknown and "[Click to Bind]" or BindName(tbl[key]))
end
table.insert(LocRefresh, render)
render()
Connect(btn.Activated, function()
listening = true
BindListening = true
render()
Tween(btn, 0.15, { BackgroundColor3 = Theme.Accent })
end)
Connect(UserInputService.InputBegan, function(input)
if not listening then return end
if input.KeyCode==Enum.KeyCode.RightShift then btn.Text="Menu key reserved"; return end
local v
if input.UserInputType == Enum.UserInputType.Keyboard then
if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
v = Enum.KeyCode.Unknown
else
v = input.KeyCode
end
elseif input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
v = input.UserInputType
else
return
end
tbl[key] = v
listening = false
task.delay(0.15, function() BindListening = false end)
render()
Tween(btn, 0.15, { BackgroundColor3 = Theme.Stroke })
RequestSave()
end)
end
local function Button(page: any, text: string, color: any, callback: ()->()): any
local b = New("TextButton", {
Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = color or Theme.Accent,
Font = Enum.Font.GothamBold, LocKey = text, TextColor3 = Color3.new(1, 1, 1), TextSize = 12, TextWrapped = true,
}, page)
Corner(b, 8)
Connect(b.Activated, callback)
local primary=color==nil or color==Theme.Accent
b.TextSize=11;b.Font=primary and Enum.Font.GothamBold or Enum.Font.GothamMedium
b.TextColor3=primary and Theme.Background or Theme.Text
Icons.Action(b,Icons.ForAction(text),b.TextColor3)
return b
end
