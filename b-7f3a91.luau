function Nav.Tip(target,content)
local token = 0
local function hide() token += 1; Nav.Tooltip.Visible = false end
local function show()
token += 1
local current = token
local epoch = Nav.TooltipEpoch
task.delay(0.35,function()
if not Alive or token ~= current or epoch ~= Nav.TooltipEpoch or not target.Parent or not Main.Visible or (Nav.Dialog and Nav.Dialog.Parent) then return end
local camera = Workspace.CurrentCamera
if not camera then return end
Nav.Tooltip.Text = type(content) == "function" and content() or content
Nav.Tooltip.Position = UDim2.fromOffset(
math.clamp(target.AbsolutePosition.X+target.AbsoluteSize.X+10,8,math.max(8,camera.ViewportSize.X-278)),
math.clamp(target.AbsolutePosition.Y,8,math.max(8,camera.ViewportSize.Y-62)))
Nav.Tooltip.Visible = true
end)
end
Connect(target.MouseEnter,show)
Connect(target.MouseLeave,hide)
Connect(target.SelectionGained,show)
Connect(target.SelectionLost,hide)
end
function Nav.Collapse(group)
if Nav.Collapsed[group] then return end
local header=group:FindFirstChildOfClass("TextLabel")
local hidden={}
for _,row in ipairs(group:GetChildren()) do if row:IsA("GuiObject") and row~=header then hidden[row]=row.Visible end end
Nav.Collapsed[group]=hidden
local token=(Ghost.Marked(group,"Expand") or 0)+1
Ghost.Mark(group,"Expand",token)
local height=group.AutomaticSize==Enum.AutomaticSize.None and group.Size.Y.Offset or Ghost.SectionHeight(group)
local toggle=header and header:FindFirstChild("Collapse"); if toggle then Icons.Section(toggle,false) end
local function finish()
if not group.Parent or Ghost.Marked(group,"Expand")~=token or not Nav.Collapsed[group] then return end
for row in pairs(hidden) do if row.Parent then row.Visible=false end end
group.AutomaticSize=Enum.AutomaticSize.Y; group.Size=UDim2.new(1,0,0,0); group.ClipsDescendants=false
end
if Ghost.Reduced() or not ConfigLoaded then finish(); return end
group.AutomaticSize=Enum.AutomaticSize.None; group.ClipsDescendants=true
group.Size=UDim2.new(1,0,0,math.max(48,height))
Tween(group,0.22,{Size=UDim2.new(1,0,0,48)},Enum.EasingStyle.Quart)
task.delay(0.23,finish)
end
function Nav.PolishControls()
for name,tab in pairs(Tabs) do
Nav.Tip(tab.Button,function() return TabName(name) .. "\n" .. Nav.Description(name) end)
if name ~= "Home" then
for _,group in ipairs(Nav.Cards(tab.Page)) do
if group:IsA("Frame") and group.AutomaticSize == Enum.AutomaticSize.Y then
local header = group:FindFirstChildOfClass("TextLabel")
if header then
New("UIPadding",{PaddingRight = UDim.new(0,26)},header)
local toggle = New("TextButton",{
Name = "Collapse",Position = UDim2.new(1,-24,0,0),Size = UDim2.fromOffset(24,24),
BackgroundTransparency = 1,Text = "",Font = Enum.Font.GothamBold,TextSize = 17,TextColor3 = Theme.SubText,
},header)
Icons.Section(toggle,true)
Connect(toggle.Activated,function()
if Nav.Collapsed[group] then Nav.Expand(group) else Nav.Collapse(group) end
end)
Nav.Tip(toggle,"Expand or collapse this group of settings.")
if group:GetAttribute("StartCollapsed") then Nav.Collapse(group) end
end
